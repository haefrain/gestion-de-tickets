# Frontend producción — build con Vite y servido como estático por nginx.
# La SPA llama a /api en el mismo origen; el edge (Caddy) enruta /api al backend, así que no
# hace falta hornear ninguna URL de API.

# ── Build ──
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web ./
RUN npm run build

# ── Runtime estático ──
FROM nginx:1.27-alpine AS prod
COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
