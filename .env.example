# ──────────────────────────────────────────────────────────────
# Variables de entorno — Plataforma de Tickets (IATSAE)
# Copia este archivo a `.env` para sobreescribir los valores por
# defecto. `make up` funciona sin `.env` (el compose trae defaults).
# ──────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=dev

# ── PostgreSQL ──
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=tickets
RABBITMQ_DEFAULT_PASS=tickets
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── Elasticsearch ──
ELASTIC_PORT=9200

# ── GlitchTip (error tracking local, compatible Sentry SDK) ──
GLITCHTIP_PORT=8000
GLITCHTIP_SECRET_KEY=dev-change-me-please-32chars-minimum
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_DB=glitchtip

# ── Puertos de aplicación ──
API_PORT=8080
WEB_PORT=5173
