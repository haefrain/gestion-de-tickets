# ── Plantilla de entorno para el despliegue de pruebas ──
# Copiar a .env.prod en la VM y rellenar. NO se versiona (.env.prod está en .gitignore).
# docker compose lee este archivo con --env-file .env.prod.

# Edge / TLS
DEPLOY_DOMAIN=tickets.tu-dominio.dev          # dominio público (o IP.nip.io) para el certificado
ACME_EMAIL=tu-correo@ejemplo.com              # email de Let's Encrypt

# Aplicación
APP_ENV=prod
DEFAULT_URI=https://tickets.tu-dominio.dev     # URL pública; el router la usa para generar enlaces absolutos
APP_SECRET=                                    # 32+ chars aleatorios: `openssl rand -hex 32`

# PostgreSQL (servicio interno postgres)
POSTGRES_USER=tickets
POSTGRES_PASSWORD=                             # contraseña fuerte
POSTGRES_DB=tickets
DATABASE_URL=postgresql://tickets:CAMBIAME@postgres:5432/tickets?serverVersion=16&charset=utf8

# Redis (servicio interno redis)
REDIS_URL=redis://redis:6379

# RabbitMQ (servicio interno rabbitmq)
RABBITMQ_DEFAULT_USER=tickets
RABBITMQ_DEFAULT_PASS=                         # contraseña fuerte
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=tickets
RABBITMQ_PASSWORD=CAMBIAME
RABBITMQ_VHOST=/
MESSENGER_TRANSPORT_DSN=amqp://tickets:CAMBIAME@rabbitmq:5672/%2f/messages

# Elasticsearch (servicio interno elasticsearch)
ELASTICSEARCH_URL=http://elasticsearch:9200

# JWT RS256 — las claves se generan en la VM (no se hornean) y se montan en config/jwt.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=                               # passphrase usada al generar el par

# Email (SMTP real en prod; null://null si no se quiere enviar)
MAILER_DSN=smtp://usuario:clave@smtp.tu-proveedor.com:587?encryption=tls

# Imágenes publicadas por el pipeline de deploy (GHCR). El tag lo fija el workflow.
IMAGE_TAG=latest
GHCR_NAMESPACE=ghcr.io/haefrain/gestion-de-tickets
